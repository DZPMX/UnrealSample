{
  "family": "SurfaceLayered",
  "instances": [
    "Watch",
    "Belt",
    "Holster",
    "Pouch"
  ],
  "features": {
    "UseScaledLeatherMicroAO": {
      "title": "带强度的皮革微 AO",
      "behavior": "True 使用 LeatherUVScale*0.6 的细节 B，并由 LeatherMicroStrength 调强度；False 使用未缩放的 LeatherUVScale 和固定 0.18 细节 AO。",
      "default": false
    },
    "UseAgingMetalLayerMasks": {
      "title": "老化金属层遮罩布局",
      "behavior": "True 采用 MetalLayerMask.R 的金属与 1-R 的皮革组合；False 使用独立 ScratchLayerMask 范围及原皮革遮罩次序。",
      "default": false
    },
    "UseMetalAgingColor": {
      "title": "老化金属与皮革颜色",
      "behavior": "True 组合金属老化／划痕、皮革及其染色；False 使用独立划痕层、MetalLightness 和皮革染色算法。",
      "default": false
    },
    "UseTintedMudColor": {
      "title": "带染色的泥颜色",
      "behavior": "True 为泥颜色乘 MudTint 和源强度；False 直接取相应泥颜色贴图。",
      "default": false
    },
    "UseAgingMetallic": {
      "title": "老化金属的金属度",
      "behavior": "True 使用金属层 Metallic 和对应遮罩；False 保留独立划痕层 ScratchMetallic 及皮革层混合。",
      "default": false
    },
    "UseAgingMetalNormalMask": {
      "title": "老化金属的法线遮罩",
      "behavior": "True 使用 MetalLayerMask.R；False 使用 1-R。只选择法线层的权重约定，不改变纹理或 TBN 符号。",
      "default": false
    },
    "UseAgingLeatherNormal": {
      "title": "老化皮革法线组合",
      "behavior": "True 加入皮革微法线、背面磨损和老化法线；False 使用基础、皮革细节与独立层的原组合。",
      "default": false
    },
    "UseAgingMetalRoughness": {
      "title": "老化金属的粗糙度层次",
      "behavior": "True 组合皮革、老化金属和原层权重；False 使用独立划痕粗糙度与基础层次。天气层随后处理。",
      "default": false
    },
    "UseUnmaskedLeatherAO": {
      "title": "全表面皮革 AO",
      "behavior": "True 全表面采用打包 AO.R 与皮革细节 B 的原分段混合；False 按金属遮罩在基础 AO 与皮革 AO 之间混合。",
      "default": false
    },
    "UseUnmaskedLeatherColor": {
      "title": "全表面皮革颜色",
      "behavior": "True 使用全表面皮革老化染色；False 按金属／皮革遮罩混合基础与皮革颜色。",
      "default": false
    },
    "UseZipperMetallic": {
      "title": "拉链金属度",
      "behavior": "True 使用 StitchAO_ZipperB.B 的拉链金属覆盖；False 保留基础表面层的金属度组合。",
      "default": false
    },
    "UsePackedLeatherNormal": {
      "title": "打包皮革法线输入",
      "behavior": "True 采用 AO_NormalGB.GB 基础法线加皮革老化和缝线；False 使用独立 BaseNormalRG、微细节、天气与缝线法线的源组合。",
      "default": false
    },
    "UseWeatherAfterStitches": {
      "title": "天气在缝线之后的层次",
      "behavior": "True 先使用缝线／拉链覆盖，再依次应用污垢、泥、湿润；False 保留污垢、泥、湿润、砂的基础层次，缝线可由末端覆盖功能加入。同步选择各层采样、权重、颜色／AO／高光与法线的配套运算，保留平方泥权重、0 哨兵和所有 Saturate。",
      "default": false
    },
    "UseFinalStitchOverlay": {
      "title": "末端缝线覆盖",
      "behavior": "True 在天气层后叠加缝线 AO、颜色、法线、粗糙度／高光及金属度遮罩；False 采用基础或先缝线后天气的输出。不会改变缝线 UV2 约定。",
      "default": false
    },
    "UseTextureBaseAO": {
      "title": "含基础贴图的皮革 AO",
      "behavior": "True 使用 BaseAOTexture／AO_NormalGB 的 R 与老化皮革、缝线和天气 AO；False 使用金属／皮革遮罩的程序微 AO。",
      "default": false
    },
    "UseStitchedLeatherColor": {
      "title": "有缝线输入的皮革颜色",
      "behavior": "True 使用贴图基础色、皮革老化与配套缝线／天气层；False 使用可选独立划痕或老化金属颜色层。",
      "default": false
    },
    "UseStitchedLeatherMetallic": {
      "title": "有缝线输入的金属度",
      "behavior": "True 使用皮革表面及可选拉链／缝线金属度；False 使用独立划痕或老化金属层。",
      "default": false
    },
    "UseStitchedLeatherNormal": {
      "title": "有缝线输入的皮革法线",
      "behavior": "True 使用独立／打包皮革基础法线与缝线、天气组合；False 使用皮革与划痕／老化金属的法线层。",
      "default": false
    },
    "UseStitchedLeatherRoughness": {
      "title": "有缝线输入的粗糙度",
      "behavior": "True 使用皮革与缝线／拉链、天气粗糙度；False 使用划痕或老化金属的层次。",
      "default": false
    },
    "UseStitchedLeatherSpecular": {
      "title": "有缝线输入的高光",
      "behavior": "True 使用皮革与缝线／拉链、天气高光；False 使用基础皮革／金属的高光层次。",
      "default": false
    }
  },
