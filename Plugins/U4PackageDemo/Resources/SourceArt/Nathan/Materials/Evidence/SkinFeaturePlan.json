  ],
  "features": {
    "UseFingerMicroMask": {
      "title": "指部遮罩微细节",
      "behavior": "True 读取指部遮罩，微细节 XY 向 0.5、细节 B 向 0.6 混合，并采用配套 AO 编码；False 直接读取普通微细节。",
      "default": false
    },
    "UseSwordWoundOverlay": {
      "title": "剑伤或水膜覆盖",
      "behavior": "True 使用剑伤 R/G 分布、染色、粗糙度及高光；False 使用水膜范围遮罩和对应表面参数。",
      "default": false
    },
    "UseSweatOverlay": {
      "title": "汗膜或新血迹覆盖",
      "behavior": "True 使用汗膜范围和表面参数；False 使用新血迹颜色／粗糙度与原黏液高光阶段参数。两边保留 >0.001 有效层判断。",
      "default": false
    },
    "UseSandWeatherInputs": {
      "title": "含砂天气层计算",
      "behavior": "True 使用污垢、泥、湿润、砂的 AO／颜色／粗糙度／高光层次；False 保留血流、污垢、泥、湿润及黏液的原层次。层范围、混合权重、平方泥权重、0 动态哨兵和各阶段 Saturate 均保留。法线计算由独立输入功能选择。",
      "default": false
    },
    "UseUniformCutSurface": {
      "title": "统一割伤的表面覆盖算法",
      "behavior": "True 使用 CutLayerAmount 的统一割伤颜色、汗珠、血流及天气层计算颜色／粗糙度／高光；False 使用分阶段割伤、瘀伤及条件覆盖层算法。这里只选择表面层算法，微细节、法线输入及散射另选。",
      "default": false
    },
    "UseDistortedCaptureAndFlowNormal": {
      "title": "扭曲采样与流动覆盖法线",
      "behavior": "True 使用 DistortionRG_BlendB 扭曲的捕获法线、阶段割伤、细节／微法线、血流／泥及双相位黏液法线；False 使用统一割伤或无扭曲捕获法线的天气组合。流动相位当前仍是截帧时间，不能称为运行时生成系统。",
      "default": true
    },
    "UseCapturedNormalWithSand": {
      "title": "捕获法线的含砂天气组合",
      "behavior": "True 在基础法线上接入无扭曲捕获结果，加细节／微法线，再按泥、湿润和砂组合；False 使用统一割伤替换、汗珠、血流和泥／湿润组合。两边 XY 的中心偏置、混合顺序与平方覆盖均保持。仅在关闭扭曲捕获／流动法线分支时参与最终输出。",
      "default": false
    },
    "UseProfileRadiusMask": {
      "title": "按遮罩映射 UE 散射半径",
      "behavior": "True 使用源散射强度开方乘 SubsurfaceMask 与 SubsurfaceBlurSize/UEProfileRadiusReference；False 使用直接散射强度开方。输出接 UE Profile Opacity，属于 UE 单 Profile 适配，不是透明覆盖。",
      "default": true
    },
    "UseSweatBeadsAndBloodSpecular": {
      "title": "汗珠与血流高光阶段",
      "behavior": "True 在源双高光适配后加入汗珠及两层血流高光；False 保留普通双高光遮罩组合。天气层和表面覆盖仍在其后求值；这不是切换 UE Shading Model。",
      "default": true
    }
  },
