{
  "material": "/Game/Demo/Character/Nathan/Material/M_Nathan_HairKajiyaFine",
  "instance": "/Game/Demo/Character/Nathan/Material/MI_Nathan_Eyebrows",
  "source_event": 51910,
  "source_shader": "Capture/51910_Pixel.txt",
  "source_parameter_byte_mapping": {
    "0": [
      "ColorOverlayTint",
      "02 BaseColor",
      "编码颜色域的 RGB 染色，随后乘 2；线性颜色转换在全部颜色处理之后。"
    ],
    "4": [
      "ColorOverlayTint",
      "02 BaseColor",
      "编码颜色域的 RGB 染色，随后乘 2；线性颜色转换在全部颜色处理之后。"
    ],
    "8": [
      "ColorOverlayTint",
      "02 BaseColor",
      "编码颜色域的 RGB 染色，随后乘 2；线性颜色转换在全部颜色处理之后。"
    ],
    "12": [
      "ColorLightness",
      "02 BaseColor",
      "以 abs(x) 混合原颜色与 0.5*x+0.5，再参与 RGB 染色；不是线性亮度倍率。"
    ],
    "16": [
      "NormalStrength",
      "03 Normal",
      "对解码后的切线 XY 进行缩放，随后重建正 Z；大值受 Z 的 saturate 限制。"
    ],
    "20": [
      "SpecularStrength",
      "04 Specular",
      "同时缩放 SpecularMask.G 和 B，两者分别驱动第一和第二高光瓣；0 关闭这两瓣。"
    ],
    "24": [
      "BaseRoughness",
      "04 Specular",
      "同时驱动两瓣指数 exp2(9-10*r)，输入按源路径 saturate；不驱动散射或背光。"
    ],
    "28": [
      "CoverageNormalization",
      "05 Coverage",
      "覆盖纹理 R 除以 max(x,1e-7) 后 saturate；随后源裁剪阈值 0.05。"
    ],
    "32": [
      "ConstantAO",
      "06 Occlusion",
      "经 saturate 后用于原高光可见度、环境遮挡和编码颜色饱和度处理。"
    ],
    "36": [
      "ShiftVariation",
      "04 Specular",
      "缩放 (SpecularMask.R-0.5)*0.2 并加入两瓣偏移；不修改法线。"
    ],
    "40": [
      "PrimaryLobeShift",
      "04 Specular",
      "第一瓣偏移；加上随机纹理变化后乘 0.5、加 0.5、saturate，再减 0.5 传入 Kajiya。"
    ],
    "44": [
      "SecondaryLobeShift",
      "04 Specular",
      "第二瓣偏移；保留原两次抵消偏移、saturate，再减 0.5 传入 Kajiya。"
    ],
    "48": [
      "BaseColorIntensity",
      "02 BaseColor",
      "原全局编码色倍率之后的材质颜色强度；在 clamp 和最终 gamma-2.2 解码之前。"
    ]
  },
